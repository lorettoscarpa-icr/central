rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // ATENÇÃO: este arquivo mostra APENAS as regras do Hub.
    // Você provavelmente já tem regras do ICR Dashboard.
    // NÃO substitua tudo — apenas ADICIONE este bloco
    // dentro do match /databases/{database}/documents existente.
    // ==========================================================

    // Hub Central — configuração das URLs dos cards
    match /hub_config/{document} {
      // Qualquer pessoa pode ler (assim Yuri/Larissa veem URLs sem login)
      allow read: if true;

      // Só o admin autorizado pode escrever
      allow write: if request.auth != null
                && request.auth.token.email == "lorettoscarpa@gmail.com";
    }

    // ==========================================================
    // FALTANDO HOJE — medido em 23/08/2026 contra o banco de verdade.
    // Estas três coleções NÃO existem nas regras, então o Firestore
    // recusa tudo (403), inclusive pro Yuri logado. O app engolia o
    // erro em silêncio:
    //
    //   conferencias     → a conferência da volta. Cada peça que o
    //                      Yuri marcava sumia no primeiro recarregar.
    //   ls_conf_licoes   → os nomes de modelo que ele ensina ao
    //                      sistema. Nunca foram aprendidos de fato.
    //   devolucoes       → devoluções.
    //
    // Enquanto isso não entrar no console, a central de estoque grava
    // a conferência no aparelho e espelha em ls_fila_etiquetas.
    // Depois de colar este bloco, ela volta sozinha pro lugar certo.
    // ==========================================================
    match /conferencias/{document} {
      allow read, write: if request.auth != null;
    }
    match /ls_conf_licoes/{document} {
      allow read, write: if request.auth != null;
    }
    match /devolucoes/{document} {
      allow read, write: if request.auth != null;
    }

  }
}
