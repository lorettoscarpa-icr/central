rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // ATENÇÃO: este arquivo mostra APENAS as regras do Hub.
    // Você provavelmente já tem regras do ICR Dashboard.
    // NÃO substitua tudo — apenas ADICIONE este bloco
    // dentro do match /databases/{database}/documents existente.
    // ==========================================================

    // Hub Central — configuração das URLs dos cards
    match /hub_config/{document} {
      // Qualquer pessoa pode ler (assim Yuri/Larissa veem URLs sem login)
      allow read: if true;

      // Só o admin autorizado pode escrever
      allow write: if request.auth != null
                && request.auth.token.email == "lorettoscarpa@gmail.com";
    }

    // ==========================================================
    // O QUE FALTA — 24/08/2026
    //
    // Correção do que eu tinha escrito aqui antes: as regras de verdade
    // TÊM um coringa no final que cobre qualquer coleção nova. Então
    // `conferencias` não está "de fora" — ela cai no coringa, que exige
    // login de e-mail (não-anônimo).
    //
    // O problema é outro: a Central de Estoque carrega só firebase-app e
    // firebase-firestore. O módulo de AUTH (firebase-auth-compat) só é
    // carregado no modo fábrica. Fora dali o painel fala com o Firestore
    // SEM credencial nenhuma — e aí:
    //
    //   ls_fila_etiquetas, ls_catalogo, ls_rep_fotos…  → `if true`, passam
    //   conferencias, ls_conf_licoes                   → coringa, recusadas
    //   entregas                                       → exige auth, recusada
    //
    // Não é coincidência: quem escreveu as regras abriu justamente as
    // coleções que o estoque usa. Faltaram estas duas.
    //
    // As duas guardam só dia, entregador, quais peças voltaram e nome de
    // modelo — nada de cliente, endereço ou telefone. Por isso entram no
    // mesmo grupo aberto das outras do estoque, e NÃO no coringa.
    //
    // `entregas` fica como está (exige login): tem nome, endereço e
    // telefone de cliente. Pra conferência conseguir ler a lista do dia,
    // o caminho certo é o painel carregar o auth e herdar o login da
    // Central — arrumar isso no código, não afrouxar a regra.
    // ==========================================================
    match /conferencias/{document=**}    { allow read, write: if true; }
    match /ls_conf_licoes/{document=**}  { allow read, write: if true; }

  }
}
